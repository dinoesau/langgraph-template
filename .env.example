APP_PORT=8000
CACHE_TTL_SECONDS=60
VALKEY_HOST=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_USER_EXPIRE_MINUTES=30
JWT_SESSION_EXPIRE_MINUTES=60
LANGSMITH_TRACING=false
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
